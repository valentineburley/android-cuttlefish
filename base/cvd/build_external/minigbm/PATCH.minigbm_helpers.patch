 #include <unistd.h>
 #include <xf86drm.h>
 #include <xf86drmMode.h>
+#include <stdarg.h>
+
+static void log_helpers(const char *func, int line, const char *fmt, ...)
+{
+	char buf[512];
+	int prefix_len = snprintf(buf, sizeof(buf), "[MINIGBM_HELPERS:%s(%d)] ", func, line);
+
+	va_list args;
+	va_start(args, fmt);
+	int msg_len = vsnprintf(buf + prefix_len, sizeof(buf) - prefix_len - 1, fmt, args);
+	va_end(args);
+
+	int total_len = prefix_len + msg_len;
+	if (total_len < (int)sizeof(buf) - 1) {
+		buf[total_len++] = '\n';
+		buf[total_len] = '\0';
+	} else {
+		buf[sizeof(buf) - 2] = '\n';
+		buf[sizeof(buf) - 1] = '\0';
+		total_len = sizeof(buf) - 1;
+	}
+
+	write(2, buf, total_len);
+
+	int file_fd = open("/tmp/minigbm.log", O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0666);
+	if (file_fd >= 0) {
+		write(file_fd, buf, total_len);
+		close(file_fd);
+	}
+}
+#define LOG_HELPERS(fmt, ...) log_helpers(__func__, __LINE__, fmt, ##__VA_ARGS__)
 
